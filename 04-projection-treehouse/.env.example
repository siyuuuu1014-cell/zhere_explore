# Runtime
NODE_ENV=development
HOST=127.0.0.1
PORT=4175
ZHERE_REPOSITORY=local
ZHERE_PROCESS_COUNT=1
ZHERE_SESSION_DAYS=30
ZHERE_SESSION_CLEANUP_INTERVAL_MS=900000
ZHERE_GUEST_CLEANUP_INTERVAL_MS=21600000
ZHERE_GUEST_CLEANUP_BATCH_SIZE=25
ZHERE_SESSION_COOKIE_SECURE=auto
ZHERE_TRUST_PROXY=false
ZHERE_AUTH_RATE_LIMIT_ENABLED=true
ZHERE_MAX_VIDEO_BYTES=104857600
ZHERE_MAX_CONCURRENT_VIDEO_UPLOADS=2
ZHERE_PUBLIC_WRITE_LIMIT=60
ZHERE_PUBLIC_WORLD_CACHE_TTL_MS=3000
ZHERE_SLOW_REQUEST_THRESHOLD_MS=1500
ZHERE_RECOMMENDATION_SYNC_ENABLED=auto
ZHERE_RECOMMENDATION_SYNC_INITIAL_DELAY_MS=30000
ZHERE_RECOMMENDATION_SYNC_INTERVAL_MS=900000
ZHERE_RECOMMENDATION_SYNC_TIMEOUT_MS=1200000
BASE_PRICE_TRANSACTION_COUNT=10
MARKET_INSIGHT_MIN_SAMPLE=5
RESEARCH_CONSENT_VERSION=research-v1
ZHERE_ADMIN_IDENTITIES=

# Feishu application and storage (copy this file to .env; never commit real secrets)
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_BITABLE_APP_TOKEN=
FEISHU_DRIVE_FOLDER_TOKEN=
FEISHU_READ_CACHE_TTL_MS=3000
FEISHU_TABLE_USERS=
FEISHU_TABLE_SESSIONS=
FEISHU_TABLE_WORLD_STATES=
FEISHU_TABLE_ASSETS=
FEISHU_TABLE_PUBLIC_ASSETS=
FEISHU_TABLE_PUBLIC_DEMANDS=
FEISHU_TABLE_PUBLIC_RESPONSES=
FEISHU_TABLE_PUBLIC_RECORDS=
FEISHU_TABLE_REPORTS=
FEISHU_TABLE_EVENTS=
FEISHU_TABLE_PASSWORD_RESETS=
FEISHU_TABLE_BIDS=
FEISHU_TABLE_TRANSACTIONS=
FEISHU_TABLE_BASE_PRICES=
FEISHU_TABLE_BASE_PRICE_VERSIONS=
FEISHU_TABLE_BID_ATTEMPTS=
FEISHU_TABLE_RESEARCH_SUBJECTS=
FEISHU_TABLE_RESEARCH_CONSENTS=
FEISHU_TABLE_RESEARCH_SESSIONS=
FEISHU_TABLE_RESEARCH_RECOMMENDATION_REQUESTS=
FEISHU_TABLE_RESEARCH_RECOMMENDATION_CANDIDATES=
FEISHU_TABLE_RESEARCH_RECOMMENDATION_IMPRESSIONS=

# Recommendation research materialized views
FEISHU_TABLE_REC_HYBRID_USER_PROFILE=
FEISHU_TABLE_REC_PUBLISHED_ASSET=
FEISHU_TABLE_REC_PUBLISHED_PROMPT=
FEISHU_TABLE_REC_PUBLISHED_COMMERCE=
FEISHU_TABLE_REC_U2A_BEHAVIOR=
FEISHU_TABLE_REC_U2P_BEHAVIOR=
FEISHU_TABLE_REC_U2C_BEHAVIOR=
FEISHU_TABLE_REC_U2U_BEHAVIOR=
FEISHU_TABLE_REC_CONTENT_FEATURES=
